# Generated by `pgx-cli codex-policy rules`.
# match: ssh comfy true
# match: docker ps
# match: psql -c 'SELECT 1'

prefix_rule(
    pattern = ["ssh"],
    decision = "forbidden",
    justification = "Use pgx-cli run thor -- ... so Mutagen, transcripts, and output limits are enforced.",
)

prefix_rule(
    pattern = ["docker"],
    decision = "forbidden",
    justification = "Use pgx-cli run docker -- ... so Mutagen, transcripts, and output limits are enforced.",
)

prefix_rule(
    pattern = ["psql"],
    decision = "forbidden",
    justification = "Use pgx-cli run psql ... so Mutagen, transcripts, and output limits are enforced.",
)

