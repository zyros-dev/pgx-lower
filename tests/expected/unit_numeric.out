CREATE SCHEMA IF NOT EXISTS test;
CREATE OR REPLACE FUNCTION test.numeric_to_i128_zero() RETURNS VOID
    AS '$libdir/pgx_lower', 'ts_test_numeric_to_i128_zero' LANGUAGE C VOLATILE;
CREATE OR REPLACE FUNCTION test.numeric_to_i128_positive() RETURNS VOID
    AS '$libdir/pgx_lower', 'ts_test_numeric_to_i128_positive' LANGUAGE C VOLATILE;
CREATE OR REPLACE FUNCTION test.numeric_to_i128_negative() RETURNS VOID
    AS '$libdir/pgx_lower', 'ts_test_numeric_to_i128_negative' LANGUAGE C VOLATILE;
CREATE OR REPLACE FUNCTION test.numeric_to_i128_rescale_up() RETURNS VOID
    AS '$libdir/pgx_lower', 'ts_test_numeric_to_i128_rescale_up' LANGUAGE C VOLATILE;
CREATE OR REPLACE FUNCTION test.numeric_to_i128_scale_down() RETURNS VOID
    AS '$libdir/pgx_lower', 'ts_test_numeric_to_i128_scale_down' LANGUAGE C VOLATILE;
CREATE OR REPLACE FUNCTION test.numeric_to_i128_large() RETURNS VOID
    AS '$libdir/pgx_lower', 'ts_test_numeric_to_i128_large' LANGUAGE C VOLATILE;
