CREATE TABLE numeric_untyped
(
    id INT,
    n  NUMERIC
);
INSERT INTO numeric_untyped(id, n)
VALUES (1, 1.2),
       (2, 1.234567890123456789),
       (3, 123456789012345678901234567890123456789.987654321),
       (4, -0.000000000000000001);
