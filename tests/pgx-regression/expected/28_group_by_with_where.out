/* <<pgx-lower-config>>: auto_should_route_to=fallback id=pgx_28_group_by_with_where_003 */
SELECT category,
       COUNT(*)          AS order_count,
       SUM(order_amount) AS total_sales,
       AVG(quantity)     AS avg_quantity
FROM product_orders
WHERE order_amount >= 100
  AND quantity <= 3
GROUP BY category
ORDER BY category;
