CREATE TABLE product_orders
(
    id            SERIAL PRIMARY KEY,
    product_name  VARCHAR(30),
    category      VARCHAR(20),
    order_amount  DECIMAL(10, 2),
    quantity      INTEGER,
    customer_type VARCHAR(15),
    order_date    DATE,
    region        VARCHAR(20)
);
