/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_29_expressions_in_aggregations_007 */
SELECT
    department,
    SUM(salary + (bonus * 2)) AS total_with_double_bonus,
    AVG(years_experience * 25) AS avg_exp_quarter
FROM comprehensive_data
WHERE salary > 70000
GROUP BY department
ORDER BY department;
