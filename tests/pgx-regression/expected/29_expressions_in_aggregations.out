/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_29_expressions_in_aggregations_004 */
SELECT
    department,
    AVG(salary + bonus) AS avg_total_comp,
    SUM(salary / 4) AS quarterly_salary_sum
FROM comprehensive_data
GROUP BY department
ORDER BY department;
