LOAD
'pgx_lower.so';
DROP TABLE IF EXISTS test_order_basic;
NOTICE:  table "test_order_basic" does not exist, skipping
CREATE TABLE test_order_basic
(
    id    SERIAL PRIMARY KEY,
    value INTEGER,
    name  INTEGER
);
INSERT INTO test_order_basic(value, name)
VALUES (30, 3),
       (10, 1),
       (20, 2),
       (40, 4),
       (15, 5);
/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_001 */
SELECT value, name
FROM test_order_basic
ORDER BY value;
 value | name 
-------+------
    10 |    1
    15 |    5
    20 |    2
    30 |    3
    40 |    4
(5 rows)

/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_002 */
SELECT value, name
FROM test_order_basic
ORDER BY value ASC;
 value | name 
-------+------
    10 |    1
    15 |    5
    20 |    2
    30 |    3
    40 |    4
(5 rows)

/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_003 */
SELECT value, name
FROM test_order_basic
ORDER BY value DESC;
 value | name 
-------+------
    40 |    4
    30 |    3
    20 |    2
    15 |    5
    10 |    1
(5 rows)

/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_004 */
SELECT value, name
FROM test_order_basic
ORDER BY name;
 value | name 
-------+------
    10 |    1
    20 |    2
    30 |    3
    40 |    4
    15 |    5
(5 rows)

DROP TABLE test_order_basic;
DROP TABLE IF EXISTS test_order_string;
NOTICE:  table "test_order_string" does not exist, skipping
CREATE TABLE test_order_string
(
    id   SERIAL PRIMARY KEY,
    name VARCHAR(20)
);
INSERT INTO test_order_string(name)
VALUES ('Charlie'),
       ('Alice'),
       ('Bob'),
       ('David'),
       ('Eve');
SET client_min_messages TO DEBUG1;
/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_005 */
SELECT name
FROM test_order_string
ORDER BY name;
  name   
---------
 Alice
 Bob
 Charlie
 David
 Eve
(5 rows)

SET client_min_messages TO NOTICE;
/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_006 */
SELECT name
FROM test_order_string
ORDER BY name DESC;
  name   
---------
 Eve
 David
 Charlie
 Bob
 Alice
(5 rows)

DROP TABLE IF EXISTS test_order_decimal;
NOTICE:  table "test_order_decimal" does not exist, skipping
CREATE TABLE test_order_decimal
(
    id     SERIAL PRIMARY KEY,
    price  NUMERIC(18, 2)
);
INSERT INTO test_order_decimal(price)
VALUES (99.99),
       (1234567890123.45),
       (0.01),
       (5000.00),
       (999999999999.99);
/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_007 */
SELECT price * 2.2
FROM test_order_decimal
ORDER BY price;
     ?column?      
-------------------
             0.022
           219.978
         11000.000
 2199999999999.978
 2716049358271.590
(5 rows)

/* <<pgx-lower-config>>: auto_should_route_to=lower id=pgx_21_order_by_basic_008 */
SELECT price
FROM test_order_decimal
ORDER BY price;
      price       
------------------
             0.01
            99.99
          5000.00
  999999999999.99
 1234567890123.45
(5 rows)

DROP TABLE test_order_decimal;
